# Copy this file to `.env` and fill in local values.
# Never commit a real `.env` file or real credentials.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-string

# Public profile links used by the portfolio (optional overrides)
GITHUB_URL=https://github.com/YOUR_GITHUB_USERNAME
LINKEDIN_URL=https://www.linkedin.com/in/YOUR_LINKEDIN_PROFILE

# Example third-party placeholders (unused unless you add integrations)
# OPENAI_API_KEY=your-api-key-here
# WEBHOOK_SECRET=your-webhook-secret-here
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
